{
  "name": "distributed-proxy-system",
  "version": "1.0.0",
  "description": "Distributed Premiere Pro Proxy Generation System using Go, Redis Streams, and FFmpeg",
  "scripts": {
    "build": "mkdir -p bin && go build -o bin/proxy-producer ./cmd/producer && go build -o bin/proxy-worker ./cmd/worker && go build -o bin/proxy-monitor ./cmd/monitor",
    "test": "go test -v ./...",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d redis",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "dev:worker": "cd worker && go run ./cmd/worker/main.go --worker-id=worker-alpha",
    "dev:orchestrator": "cd orchestrator && java -jar target/orchestrator-1.0.0-SNAPSHOT.jar",
    "dev:pipeline-local": "cd worker && go run ./cmd/local_pipeline/main.go -source ../test_assets/sample_source.mp4 -concurrency 4 -output-dir ../test_assets/out_par",
    "job:submit": "curl -s -X POST http://localhost:8080/api/v1/jobs -H 'Content-Type: application/json' -d '{\"sourcePath\": \"'\"$(pwd)\"'/test_assets/sample_source.mp4\", \"targetChunkSec\": 5.0, \"codec\": \"libx264\", \"preset\": \"veryfast\", \"bitrate\": \"3M\", \"outputFilename\": \"final_rendered_output.mp4\"}'",
    "demo": "bash scripts/demo.sh",
    "render:xml": "python3 scripts/xml_render_farm.py",
    "e2e": "bash scripts/test_phase3_e2e.sh"
  },
  "keywords": [
    "distributed-systems",
    "redis-streams",
    "ffmpeg",
    "premiere-pro",
    "video-proxy",
    "golang",
    "fault-tolerance"
  ],
  "author": "",
  "license": "MIT"
}
