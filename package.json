{
  "name": "distributed-proxy-system",
  "version": "1.0.0",
  "description": "Distributed Premiere Pro Proxy Generation System using Go, Redis Streams, and FFmpeg",
  "scripts": {
    "build": "mkdir -p bin && go build -o bin/proxy-producer ./cmd/producer && go build -o bin/proxy-worker ./cmd/worker && go build -o bin/proxy-monitor ./cmd/monitor",
    "test": "go test -v ./...",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d redis",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "footage:gen": "bash scripts/generate_test_footage.sh 6",
    "proxy:produce": "./bin/proxy-producer -input ./test_footage/raw -output ./proxies -codec prores",
    "proxy:worker": "./bin/proxy-worker --worker-id=worker-alpha",
    "proxy:monitor": "./bin/proxy-monitor",
    "benchmark": "bash scripts/benchmark.sh 12",
    "demo:fault": "bash scripts/demo_fault_tolerance.sh",
    "verify": "bash scripts/verify_premiere_compatibility.sh"
  },
  "keywords": [
    "distributed-systems",
    "redis-streams",
    "ffmpeg",
    "premiere-pro",
    "video-proxy",
    "golang",
    "fault-tolerance"
  ],
  "author": "",
  "license": "MIT"
}
